# ==================================================================
# SINU CONTROL - API  (copiar a .env y completar; .env NO se sube a Git)
# ==================================================================

# Clave secreta para firmar los tokens JWT. NUNCA la comparta.
# Generar con: python scripts/generate_secret.py
SECRET_KEY=

# CORS: origenes permitidos separados por comas.
# Vacio = solo el frontend local (http://localhost:5173). NUNCA usar '*'.
CORS_ALLOWED_ORIGINS=

# Expiracion del token JWT en minutos (un turno de servicio = 8 h)
JWT_EXP_MINUTES=480

# Dias de anticipacion por defecto para alertar vencimientos
DIAS_ALERTA_DEFECTO=3

# ==================================================================
# BASE DE DATOS: MySQL 8 (obligatoria)
# ==================================================================
# Cree la base con: python scripts/create_db.py
# Luego las tablas: flask db upgrade
# Y los datos de ejemplo: python scripts/seed.py
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sinu_db
DB_CHARSET=utf8mb4

# Flask CLI (flask db ...)
FLASK_APP=app:crear_app

# ==================================================================
# PRUEBAS (opcional)
# ==================================================================
# pytest usa SQLite en memoria. Para correr la misma suite contra MySQL:
# TEST_DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/sinu_test?charset=utf8mb4
